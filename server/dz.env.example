DZ_DATABASE=/var/lib/dz/dz.sqlite3
DZ_SERVER_PORT=4286
DZ_ALLOWED_ORIGINS=https://artemchebchips.github.io
DZ_ASR_MODEL=/var/lib/dz/parakeet
DZ_ASR_THREADS=2
DZ_TRUST_PROXY=1
# Абсолютный путь к Claude Code, установленному для пользователя dz:
DZ_CLAUDE_BIN=/opt/dz/bin/claude
# Никаких API-ключей в этой конфигурации.
